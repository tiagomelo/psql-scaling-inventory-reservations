# psql connection settings
POSTGRES_USER=test
POSTGRES_PASSWORD=test
POSTGRES_DB=inventory
POSTGRES_PORT=5432
## port exposed on the host; change it if 5432 is already taken
POSTGRES_HOST_PORT=5432
POSTGRES_HOST=localhost
## health check settings for postgres
POSTGRES_HEALTH_CHECK_INTERVAL=5s
POSTGRES_HEALTH_CHECK_TIMEOUT=3s
POSTGRES_HEALTH_CHECK_RETRIES=5
## enough connections for the highest concurrency level, plus exporters and psql
POSTGRES_MAX_CONNECTIONS=1100

# benchmark params
STRATEGIES=counter,skip-locked,skip-locked-sharded,skip-locked-pool
WORKERS=1,10,25,50,100,250,500,1000
## each run lasts DURATION; if empty, each run performs OPERATIONS attempts instead
DURATION=30s
OPERATIONS=100000
QUANTITY=1
STOCK=2000000
COOLDOWN=20s
METRICS_PORT=2112

# postgres exporter settings
POSTGRES_EXPORTER_PORT=9187

# grafana settings
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin123
GF_LOG_FILTERS=rendering:debug

# grafana rendering settings
GF_RENDERING_SERVER_URL=http://renderer:8081/render
GF_RENDERING_CALLBACK_URL=http://grafana:3000/
GF_RENDERING_SERVER_ENABLED=true
GRAFANA_RENDERING_PORT=8081
## shared secret between grafana and the image renderer
GF_RENDERING_RENDERER_TOKEN=inventory-bench-renderer-token

# prometheus settings
PROMETHEUS_PORT=9090

# Container names
POSTGRES_DATABASE_CONTAINER_NAME=postgres
POSTGRES_EXPORTER_CONTAINER_NAME=postgres_exporter
GRAFANA_RENDERER_CONTAINER_NAME=renderer
GRAFANA_CONTAINER_NAME=grafana
PROMETHEUS_CONTAINER_NAME=prometheus
